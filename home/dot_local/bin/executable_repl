#!/usr/bin/env bash

! command -v tmux >& /dev/null && echo "tmux not installed" && exit 1

# TODO: add a check to do it only if there is more than one tmux windows

input=$(cat)

# Determine target pane based on right pane position
target_pane="left"

# Get the currently active (focused) right pane
active_right_pane=$(tmux display-message -p '#{pane_id}')
current_pane_info=$(tmux list-panes -F '#{pane_id} #{pane_at_top} #{pane_at_bottom} #{pane_at_left} #{pane_at_right}' | grep "^$active_right_pane")

if [[ -n "$current_pane_info" ]]; then
    read -r _ at_top at_bottom _ at_right <<< "$current_pane_info"

    if [[ "$at_right" == "1" ]]; then
        if [[ "$at_top" == "1" ]]; then
            left_top=$(tmux list-panes -F '#{pane_id} #{pane_at_top} #{pane_at_left}' | awk '$2 == 1 && $3 == 1 {print $1}' | head --lines=1)
            if [[ -n "$left_top" ]]; then
                target_pane="$left_top"
            fi
        elif [[ "$at_bottom" == "1" ]]; then
            left_bottom=$(tmux list-panes -F '#{pane_id} #{pane_at_bottom} #{pane_at_left}' | awk '$2 == 1 && $3 == 1 {print $1}' | head --lines=1)
            if [[ -n "$left_bottom" ]]; then
                target_pane="$left_bottom"
            fi
        fi
    fi
fi

if [[ -z "${1}" ]]; then
	echo "${input}" | tmux load-buffer -
	tmux paste-buffer -t "$target_pane"
else
	echo "${1}" | tmux load-buffer -
	tmux paste-buffer -t "$target_pane"
fi

tmux show-buffer
