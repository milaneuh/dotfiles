#!/bin/bash

umask 077

workdir="$(mktemp --directory)"
trap 'rm --recursive --force "${workdir}"' EXIT

input="${workdir}/input.png"
output="${workdir}/output"

! which flameshot && echo "flameshot is not installed"
! which tesseract && echo "tesseract is not installed"

# TODO: why tesseract a txt extension on debian ?
flameshot gui --path "${input}" >/dev/null 2>&1
tesseract "${input}" "${output}" -l eng
[[ -f "${output}.txt" ]] && xclip -in -selection clipboard <"${output}.txt"
[[ -f "${output}" ]] && xclip -in -selection clipboard <"${output}"
