#!/bin/bash
set -o errexit -o nounset -o pipefail

# Goal:
#   Loads the personal GNOME configuration (~/.config/gnome-desktop/*.conf) into
#   the dconf database, then removes any other key found under the managed paths.

# Glossary:
#   dconf     : binary database (~/.config/dconf/user) where GNOME stores deviations from defaults
#   schema    : GSettings description of keys (types, defaults)
#   path      : location in the dconf tree, ends with / (e.g. /org/gnome/mutter/)
#   keyfile   : INI file in dconf format (*.conf)
#   stale key : key present in dconf but absent from the keyfiles

CONF_DIR="$HOME/.config/gnome-desktop"

FORGE_UUID=forge@jmmaranan.com
GO_TO_LAST_WORKSPACE_UUID=gnome-shell-go-to-last-workspace@github.com
FORGE_SCHEMA_DIR="$HOME/.local/share/gnome-shell/extensions/$FORGE_UUID/schemas"
FORGE_KEYBINDINGS_SCHEMA=org.gnome.shell.extensions.forge.keybindings
FORGE_KEYBINDINGS_PATH=/org/gnome/shell/extensions/forge/keybindings/

MANAGED_PATHS=(
  /org/gnome/desktop/wm/keybindings/
  /org/gnome/settings-daemon/plugins/media-keys/
  /org/gnome/shell/extensions/forge/
  /org/gnome/shell/extensions/go-to-last-workspace/
)

keyfile_keys() {
  awk -F '=' '
    /^\[/ { section = substr($0, 2, length($0) - 2) }
    /^[a-z]/ { print "/" section "/" $1 }
  ' "$CONF_DIR"/*.conf | sort
}

dconf_keys() {
  dconf dump "$1" | awk -F '=' -v root="$1" '
    /^\[/ {
      section = substr($0, 2, length($0) - 2)
      section = (section == "/") ? "" : section "/"
    }
    /^[a-z]/ { print root section $1 }
  ' | sort
}

prune_stale_keys() {
  local root=$1
  local keys_in_dconf keys_in_conf stale_keys

  keys_in_dconf=$(dconf_keys "$root")
  keys_in_conf=$(keyfile_keys | { grep "^$root" || true; })
  stale_keys=$(comm -23 <(printf '%s\n' "$keys_in_dconf") <(printf '%s\n' "$keys_in_conf"))

  if [[ -n "$stale_keys" ]]; then
    while read -r key; do
      dconf reset "$key"
    done <<< "$stale_keys"
  fi
}

forge_setting() {
  local command=$1
  shift
  GSETTINGS_SCHEMA_DIR="$FORGE_SCHEMA_DIR" gsettings "$command" "$FORGE_KEYBINDINGS_SCHEMA" "$@"
}

disable_undeclared_forge_keybindings() {
  local declared_keys key value

  [[ -d "$FORGE_SCHEMA_DIR" ]] || return 0

  declared_keys=$(keyfile_keys | { grep "^$FORGE_KEYBINDINGS_PATH" || true; })

  while read -r key; do
    if grep --quiet --line-regexp "$FORGE_KEYBINDINGS_PATH$key" <<< "$declared_keys"; then
      continue
    fi

    value=$(forge_setting get "$key")
    if [[ "$value" != \[* && "$value" != @as* ]]; then
      continue
    fi

    dconf write "$FORGE_KEYBINDINGS_PATH$key" "@as []"
  done < <(forge_setting list-keys)
}

enable_extension() {
  local uuid=$1
  local enabled

  enabled=$(gsettings get org.gnome.shell enabled-extensions)

  if [[ "$enabled" == *"'$uuid'"* ]]; then
    return 0
  fi

  if [[ "$enabled" == "@as []" || "$enabled" == "[]" ]]; then
    gsettings set org.gnome.shell enabled-extensions "['$uuid']"
  else
    gsettings set org.gnome.shell enabled-extensions "${enabled%]}, '$uuid']"
  fi
}

dconf load / < "$CONF_DIR/desktop.conf"
dconf load / < "$CONF_DIR/keybindings.conf"
dconf load / < "$CONF_DIR/forge.conf"

for path in "${MANAGED_PATHS[@]}"; do
  prune_stale_keys "$path"
done

disable_undeclared_forge_keybindings

gnome-extensions disable "$FORGE_UUID"
gnome-extensions enable "$FORGE_UUID"

enable_extension "$GO_TO_LAST_WORKSPACE_UUID"
