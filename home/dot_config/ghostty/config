theme = Gruvbox Dark

# Même lancement que alacritty : bash login interactif puis tmux
command = shell:$HOME/.nix-profile/bin/bash -lic "exec tmux new-session -A -s main"

macos-option-as-alt = true
window-theme = dark

font-family = JetBrainsMono Nerd Font Mono
font-size = 13
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic

# Mêmes ré-encodages que alacritty (user-keys tmux)
keybind = alt+left_bracket=text:\x1b[777~
keybind = ctrl+shift+q=text:\x1b[778~
