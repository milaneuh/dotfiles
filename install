#!/bin/bash

NIX_VERSION="2.34.3"
NIX_INSTALLER_SHA256="15af988e88ffc16d5d4abd6e1d100eba8b0dff6a41c6e03a7718c2b4a87e0cd6"

forge_accepts_ssh_key() {
	local host="$1"

	ssh -T -o ConnectTimeout=10 "git@${host}" 2>&1 |
		grep --quiet --extended-regexp 'Welcome to GitLab|successfully authenticated'
}

require_forge_ssh_keys() {
	local host

	for host in gitlab.com github.com; do
		while ! forge_accepts_ssh_key "${host}"; do
			cat <<-EOF
				${host} did not accept your SSH key. Create one if needed, then add
				the public key to your account:
				  ssh-keygen -t ed25519 -C "your_email@example.com"
				  cat ~/.ssh/id_ed25519.pub
			EOF
			read -r -p "Retry? [y/N] " response
			if [[ ! "${response}" =~ ^[Yy]$ ]]; then
				exit 1
			fi
		done
	done
}

install() {
	sudo apt --yes install "$@"
}

cleanup_default_folders() {
	[[ -e ~/.bashrc ]] && rm ~/.bashrc
	[[ -e ~/.profile ]] && rm ~/.profile
	[[ -e ~/Bureau ]] && rmdir ~/Bureau
	[[ -e ~/Desktop ]] && rmdir ~/Desktop
	[[ -e ~/Documents ]] && rmdir ~/Documents
	[[ -e ~/Downloads ]] && rmdir ~/Downloads
	[[ -e ~/Images ]] && rmdir ~/Images
	[[ -e ~/Music ]] && rmdir ~/Music
	[[ -e ~/Modèles ]] && rmdir ~/Modèles
	[[ -e ~/Musiques ]] && rmdir ~/Musiques
	[[ -e ~/Pictures ]] && rmdir ~/Pictures
	[[ -e ~/Public ]] && rmdir ~/Public
	[[ -e ~/Publics ]] && rmdir ~/Publics
	[[ -e ~/Templates ]] && rmdir ~/Templates
	[[ -e ~/Téléchargements ]] && rmdir ~/Téléchargements
	[[ -e ~/Videos ]] && rmdir ~/Videos
	[[ -e ~/Vidéos ]] && rmdir ~/Vidéos
}

install_apt_packages() {
	sudo apt update

	install git
	install curl
	install keyd
}

install_nix() {
	sudo apt purge --yes nix-bin nix-setup-systemd
	sudo rm --recursive --force /nix

	if getent group nix-users >/dev/null; then
		sudo groupdel nix-users
	fi

	local installer
	installer="$(mktemp)"
	curl --location --fail --output "${installer}" \
		"https://releases.nixos.org/nix/nix-${NIX_VERSION}/install"

	if ! echo "${NIX_INSTALLER_SHA256}  ${installer}" | sha256sum --check --status; then
		echo "nix installer checksum mismatch, aborting" >&2
		rm --force "${installer}"
		exit 1
	fi

	sh "${installer}" --daemon
	rm --force "${installer}"

	if [[ -r /etc/profile.d/nix.sh ]]; then
		# shellcheck source=/dev/null
		source /etc/profile.d/nix.sh
	fi
}

install_home_manager() {
	local activation
	activation="$(nix --extra-experimental-features 'nix-command flakes' build --no-link \
		--print-out-paths "${HOME}/.dotfiles/nix#homeConfigurations.${USER}.activationPackage")"
	HOME_MANAGER_BACKUP_EXT=backup "${activation}/activate"
	export PATH="${HOME}/.nix-profile/bin:${PATH}"
}

install_graphical_software() {
	snap install firefox # Nix builds cannot use the AppArmor profile that confines the browser
}

configure_system() {
	sudo update-alternatives --install /usr/bin/vi vi "${HOME}/.nix-profile/bin/nvim" 60
	sudo update-alternatives --set vi "${HOME}/.nix-profile/bin/nvim"

	if grep --quiet '^[[:space:]]*GSSAPIAuthentication' /etc/ssh/ssh_config; then
		sudo sed --in-place 's/^\([[:space:]]*\)\(GSSAPIAuthentication\)/\1#\2/' /etc/ssh/ssh_config
	fi
}

gpg_key_is_usable() {
	local fingerprint

	fingerprint="$(gpg --list-secret-keys --with-colons 2>/dev/null |
		awk -F: '/^fpr:/{print $10; exit}')"

	if [[ -z "${fingerprint}" ]]; then
		return 1
	fi

	gpg --list-keys --with-colons "${fingerprint}" 2>/dev/null |
		awk -F: '/^pub:/{exit ($2 == "u") ? 0 : 1}'
}

require_gpg_key() {
	while ! gpg_key_is_usable; do
		cat <<-'EOF'
			The password store needs your GPG key. Import both blocks from your
			backup:
			  gpg --import
			  gpg --import-ownertrust

			The ownertrust is not optional. Without it the store is read only:
			pass show works, pass insert fails with "unusable public key". To set
			it by hand run gpg --edit-key <fingerprint>, then trust, 5, y, quit.
		EOF
		read -r -p "Retry? [y/N] " response
		if [[ ! "${response}" =~ ^[Yy]$ ]]; then
			exit 1
		fi
	done
}

clone_repositories() {
	if [[ ! -d ~/remoterepos/zettelkasten ]]; then
		git clone git@gitlab.com:maxencetholomier/zettelkasten.git ~/remoterepos/zettelkasten/
	fi

	if [[ ! -d ~/.password-store ]]; then
		git clone git@gitlab.com:maxencetholomier/secrets.git ~/.password-store
	fi

	if [[ ! -d ~/remoterepos/projects/knowledge ]]; then
		git clone git@github.com:maxencetholomier/knowledge.git ~/remoterepos/projects/knowledge
	fi

	sudo ~/remoterepos/projects/knowledge/install
}

print_manual_steps() {
	cat <<-'EOF'
		Installation finished

		Manual installation required:
			- Create ~/.gitconfig.local with your git email:
			    git config --file ~/.gitconfig.local user.email your_email@example.com
			- Check the password store works:
			    pass show raspi/luks
		Log out and back in: the nix profile PATH and the GNOME shell
		extensions shipped by nix are only picked up by a new session.
		Reboot to reload gnome application.
	EOF
}

require_forge_ssh_keys
cleanup_default_folders

install_apt_packages
install_nix
install_home_manager
install_graphical_software
configure_system
require_gpg_key
clone_repositories

print_manual_steps
