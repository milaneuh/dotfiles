#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

NIX_VERSION="2.35.2"
NIX_INSTALLER_SHA256="9adda97297d9e8ab360df95c729eabff4f4f93d6db091953c3a68f29e3fb130c"

DOTFILES_REPOSITORY="milaneuh/dotfiles"

in_container() {
	[[ -n ${DEVPOD:-} || -n ${REMOTE_CONTAINERS:-} || -f /.dockerenv ]]
}

nix_command() {
	nix --extra-experimental-features 'nix-command flakes' "$@"
}

sha256_of() {
	if command -v sha256sum >/dev/null; then
		sha256sum "$1" | cut -d ' ' -f 1
	else
		shasum -a 256 "$1" | cut -d ' ' -f 1
	fi
}

load_nix() {
	local profile

	for profile in /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
		"${HOME}/.nix-profile/etc/profile.d/nix.sh"; do
		if [[ -r ${profile} ]]; then
			set +o nounset
			# shellcheck source=/dev/null
			source "${profile}"
			set -o nounset
			break
		fi
	done

	export PATH="${HOME}/.nix-profile/bin:${PATH}"
}

install_nix() {
	if [[ -d /nix/store ]]; then
		load_nix
		return
	fi

	local installer
	installer="$(mktemp)"
	curl --location --fail --silent --show-error --output "${installer}" \
		"https://releases.nixos.org/nix/nix-${NIX_VERSION}/install"

	if [[ "$(sha256_of "${installer}")" != "${NIX_INSTALLER_SHA256}" ]]; then
		echo "nix installer checksum mismatch, aborting" >&2
		rm -f "${installer}"
		exit 1
	fi

	if in_container; then
		sh "${installer}" --no-daemon --yes --no-channel-add
	else
		sh "${installer}" --daemon --yes --no-channel-add </dev/tty
	fi
	rm -f "${installer}"

	load_nix
}

install_rosetta() {
	if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
		return
	fi

	if /usr/bin/pgrep -q oahd; then
		return
	fi

	sudo softwareupdate --install-rosetta --agree-to-license
}

chezmoi_command() {
	if command -v chezmoi >/dev/null; then
		chezmoi "$@"
	else
		nix_command run nixpkgs#chezmoi -- "$@"
	fi
}

checkout_directory() {
	local directory
	directory="$(cd "$(dirname "${BASH_SOURCE[0]:-.}")" 2>/dev/null && pwd)"

	if [[ -f "${directory}/.chezmoiroot" ]]; then
		echo "${directory}"
	fi
}

apply_dotfiles() {
	local checkout
	checkout="$(checkout_directory)"

	if [[ -n ${checkout} ]]; then
		mkdir -p "${HOME}/.config/chezmoi"
		printf 'sourceDir = "%s"\n' "${checkout}" >"${HOME}/.config/chezmoi/chezmoi.toml"
	fi

	if in_container; then
		if [[ -n ${checkout} ]]; then
			chezmoi_command apply --force --no-tty
		else
			chezmoi_command init --apply --force --no-tty --use-builtin-git true \
				"https://github.com/${DOTFILES_REPOSITORY}.git"
		fi
	elif [[ -n ${checkout} ]]; then
		chezmoi_command apply </dev/tty
	else
		chezmoi_command init --apply --use-builtin-git true \
			"https://github.com/${DOTFILES_REPOSITORY}.git" </dev/tty
	fi
}

github_accepts_ssh_key() {
	local output
	output="$(ssh -o RequestTTY=no -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new git@github.com 2>&1 || true)"

	grep -q 'successfully authenticated' <<<"${output}"
}

setup_github_ssh() {
	if ! github_accepts_ssh_key; then
		gh auth login --hostname github.com --git-protocol ssh --web </dev/tty
	fi

	chezmoi git -- remote set-url origin "git@github.com:${DOTFILES_REPOSITORY}.git"
}

configure_devpod() {
	if ! devpod provider list --output json | grep -q '"docker"'; then
		devpod provider add docker
	fi

	mkdir -p "${HOME}/.ssh/config.d"
	chmod 700 "${HOME}/.ssh/config.d"

	devpod context set-options \
		-o DOTFILES_URL="https://github.com/${DOTFILES_REPOSITORY}" \
		-o DOTFILES_SCRIPT=install \
		-o SSH_CONFIG_PATH="${HOME}/.ssh/config.d/devpod"
	devpod ide use none
}

set_login_shell() {
	local shell="${HOME}/.nix-profile/bin/bash"

	if ! grep -qxF "${shell}" /etc/shells; then
		echo "${shell}" | sudo tee -a /etc/shells >/dev/null
	fi

	if [[ "${SHELL:-}" != "${shell}" ]]; then
		chsh -s "${shell}" </dev/tty
	fi
}

print_manual_steps() {
	cat <<-'EOF'
		Installation finished

		Log out and back in so the new login shell and session variables apply.
		On macOS, Alacritty is in ~/Applications/Home Manager Apps and Colima starts
		at login; check it with: colima status
	EOF
}

install_nix
install_rosetta
apply_dotfiles

if in_container; then
	echo "Dotfiles applied"
	exit
fi

setup_github_ssh
configure_devpod
set_login_shell

print_manual_steps
