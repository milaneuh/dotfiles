#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

github_accepts_ssh_key() {
	ssh -o RequestTTY=no -o ConnectTimeout=10 git@github.com 2>&1 |
		grep --quiet 'successfully authenticated'
}

require_ssh_key() {
	local response

	while ! github_accepts_ssh_key; do
		cat <<-EOF
			github.com did not accept your SSH key. Create one if needed, then add
			the public key to your account:
			  ssh-keygen -t ed25519 -C "your_email@example.com"
			  cat ~/.ssh/id_ed25519.pub
		EOF
		read -r -p "Retry? [y/N] " response
		if [[ ! "${response}" =~ ^[Yy]$ ]]; then
			exit 1
		fi
	done
}

install_home_manager() {
	local activation
	activation="$(nix --extra-experimental-features 'nix-command flakes' build --no-link \
		--print-out-paths "${HOME}/.dotfiles/nix#homeConfigurations.${USER}.activationPackage")"
	HOME_MANAGER_BACKUP_EXT=backup "${activation}/activate"
	export PATH="${HOME}/.nix-profile/bin:${PATH}"
}

require_ssh_key
install_home_manager

echo "Installation finished. Open a new shell: the nix profile PATH is only picked up by a new session."
