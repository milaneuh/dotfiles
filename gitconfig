[user]
	# Fill in before your first commit inside a container — deliberately
	# left blank rather than guessed, so commits don't get the wrong author.
	name =
	email =

[init]
	defaultBranch = main

[alias]
	autofixup = "!f() { GIT_EDITOR=true git commit --fixup $1 && git rebase --autosquash --interactive --rebase-merges $1~1; }; f"
