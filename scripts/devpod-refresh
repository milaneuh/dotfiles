#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

workspace_argument="."
if (($#)) && [[ $1 != -* ]]; then
	workspace_argument="$1"
	shift
fi

workspace="$(cd "${workspace_argument}" && pwd)"

config=""
for candidate in "${workspace}/.devcontainer/devcontainer.json" "${workspace}/.devcontainer.json"; do
	if [[ -f ${candidate} ]]; then
		config="${candidate}"
		break
	fi
done

if [[ -z ${config} ]]; then
	echo "No devcontainer.json in ${workspace}" >&2
	exit 1
fi

image="$(grep -oE '"image"[[:space:]]*:[[:space:]]*"[^"]+"' "${config}" | head -n 1 | cut -d '"' -f 4 || true)"

if [[ -z ${image} ]]; then
	echo "No image in ${config}" >&2
	exit 1
fi

if command -v sha256sum >/dev/null; then
	path_hash="$(printf '%s' "${workspace}" | sha256sum | cut -c 1-5)"
else
	path_hash="$(printf '%s' "${workspace}" | shasum -a 256 | cut -c 1-5)"
fi

name="$(basename "${workspace}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
cache="vsc-${name}-${path_hash}"

previous_base="$(docker image inspect --format '{{.Id}}' "${image}" 2>/dev/null || true)"

docker pull "${image}"

current_base="$(docker image inspect --format '{{.Id}}' "${image}" 2>/dev/null || true)"

read -r -a cached_tags <<<"$(docker images --filter "reference=${cache}:*" --format '{{.Repository}}:{{.Tag}}' | tr '\n' ' ')"
read -r -a cached_ids <<<"$(docker images --filter "reference=${cache}:*" --quiet | sort -u | tr '\n' ' ')"

if ((${#cached_tags[@]})); then
	docker rmi --force "${cached_tags[@]}" >/dev/null
	echo "Dropped devpod cache ${cache}"
fi

status=0
devpod up "${workspace}" --recreate "$@" || status=$?

if ((${#cached_ids[@]})); then
	docker rmi "${cached_ids[@]}" >/dev/null 2>&1 || true
fi

if [[ -n ${previous_base} && ${previous_base} != "${current_base}" ]]; then
	if docker rmi "${previous_base}" >/dev/null 2>&1; then
		echo "Removed previous base image ${previous_base:7:12}"
	fi
fi

exit "${status}"
