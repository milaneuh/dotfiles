#!/bin/bash

# Mount and unmount the raspi LUKS-encrypted disk over sshfs

! command -v ssh >& /dev/null && echo "ssh not installed" && exit 1
! command -v sshfs >& /dev/null && echo "sshfs not installed" && exit 1
command -v fusermount3 >& /dev/null && FUSERMOUNT="fusermount3" || FUSERMOUNT="fusermount"

SSH_HOST="raspi"
DEVICE="/dev/sda1"
MAPPER="drive"
REMOTE_MOUNT="/mnt/drive"
LOCAL_MOUNT="${HOME}/mnt/drive"

# Help and arguments -----------------------------------------------------------

help() {
	echo "raspi : raspi [command]
    mount and unmount the raspi encrypted disk over sshfs
    commands:
        mount   unlock and mount the disk on the raspi, then mount it locally
        umount  unmount locally, then unmount and lock the disk on the raspi"
}

declare -a COMMANDS=(mount umount)

check_args() {
	for c in "${COMMANDS[@]}"; do
		[[ "${c}" == "${1}" ]] && return 0
	done
	return 1
}

if ! check_args "${1}"; then
	help
	exit 1
fi

# script -----------------------------------------------------------------------

unlock_remote_disk() {
	ssh -t "${SSH_HOST}" "
		test -e /dev/mapper/${MAPPER} || sudo cryptsetup open ${DEVICE} ${MAPPER} || exit 1
		sudo mkdir --parents ${REMOTE_MOUNT}
		mountpoint --quiet ${REMOTE_MOUNT} || sudo mount /dev/mapper/${MAPPER} ${REMOTE_MOUNT} || exit 1
	"
}

lock_remote_disk() {
	ssh -t "${SSH_HOST}" "
		! mountpoint --quiet ${REMOTE_MOUNT} || sudo umount ${REMOTE_MOUNT} || exit 1
		! test -e /dev/mapper/${MAPPER} || sudo cryptsetup close ${MAPPER} || exit 1
	"
}

attach_local_mount() {
	mkdir --parents "${LOCAL_MOUNT}"
	sshfs -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 \
		"${SSH_HOST}:${REMOTE_MOUNT}" "${LOCAL_MOUNT}"
}

detach_local_mount() {
	"${FUSERMOUNT}" -u "${LOCAL_MOUNT}" 2> /dev/null
}

mount_drive() {
	unlock_remote_disk || exit 1

	if mountpoint --quiet "${LOCAL_MOUNT}"; then
		echo "already mounted: ${LOCAL_MOUNT}"
		exit 0
	fi

	detach_local_mount
	attach_local_mount || exit 1
	echo "mounted: ${LOCAL_MOUNT}"
}

umount_drive() {
	detach_local_mount
	lock_remote_disk || exit 1
	echo "unmounted: ${LOCAL_MOUNT}"
}

case ${1} in
mount) mount_drive ;;
umount) umount_drive ;;
esac
