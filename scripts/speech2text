#!/bin/bash

MODELS_DIR="${WHISPER_MODELS_DIR}"
WHISPER_CLI="whisper-cli"
MODEL="${1:-${MODELS_DIR}/ggml-small-q5_1.bin}"
VAD_MODEL="${MODELS_DIR}/ggml-silero-v6.2.0.bin"
TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
OUTPUT="/tmp/recording_${TIMESTAMP}.wav"
LOG="/tmp/speech2text_${TIMESTAMP}.log"
TRANSCRIPT="/tmp/transcript_${TIMESTAMP}.txt"
LANGUAGE="fr"

abort() {
    echo "$1" >&2
    read -rsn1 -p "Press any key to close..."
    exit 1
}

copy_to_clipboard() {
    setsid --fork xclip -selection clipboard -in "$1" >/dev/null 2>&1
}

command -v "${WHISPER_CLI}" >/dev/null || abort "${WHISPER_CLI} not found in PATH"
[[ ! -f "${MODEL}" ]] && abort "model not found: ${MODEL}"
[[ ! -f "${VAD_MODEL}" ]] && abort "vad model not found: ${VAD_MODEL}"

echo "Recording... (Ctrl+C to stop)"
arecord --format S16_LE --rate 16000 --channels 1 "${OUTPUT}" 2> >(tee --append "${LOG}" >&2)

echo "Transcribing... (do not Ctrl+C)"
"${WHISPER_CLI}" \
    --model "${MODEL}" \
    --language "${LANGUAGE}" \
    --no-timestamps \
    --suppress-nst \
    --vad \
    --vad-model "${VAD_MODEL}" \
    --file "${OUTPUT}" \
    >"${TRANSCRIPT}" 2> >(tee --append "${LOG}" >&2) \
    || abort "transcription failed, see ${LOG}"

cat "${TRANSCRIPT}"
copy_to_clipboard "${TRANSCRIPT}"
