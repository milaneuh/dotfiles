#!/bin/bash

# Completion -------------------------------------------------------------------

declare -a COMMANDS=(toggle reload monitor)

if [[ -n ${COMP_LINE} ]]; then
	for c in "${COMMANDS[@]}"; do
		[[ ${c:0:${#2}} == "${2,,}" ]] && echo "${c}"
	done
	exit
fi

# Script -----------------------------------------------------------------------

STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}"
STATE_FILE="${STATE_DIR}/theme"
COLOR_SCHEME_KEY="org.gnome.desktop.interface color-scheme"

current_variant() {
	# shellcheck disable=SC2086
	if [[ $(gsettings get ${COLOR_SCHEME_KEY}) =~ dark ]]; then
		echo "dark"
	else
		echo "light"
	fi
}

toggle() {
	if [[ $(current_variant) == "dark" ]]; then
		gsettings set org.gnome.desktop.interface gtk-theme 'default'
		gsettings set org.gnome.desktop.interface color-scheme 'default'
	else
		gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
		gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
	fi
}

reload() {
	mkdir --parents "${STATE_DIR}"
	printf '%s\n' "$(current_variant)" >"${STATE_FILE}"

	if tmux has-session 2>/dev/null; then
		tmux source-file ~/.tmux.conf.d/appearance.conf
	fi

	for socket in "${XDG_RUNTIME_DIR}"/nvim.*; do
		[[ -S ${socket} ]] || continue
		timeout 1 nvim --server "${socket}" \
			--remote-expr "luaeval(\"pcall(require('theme').apply)\")" >/dev/null 2>&1 &
	done

	wait
}

monitor() {
	reload
	# shellcheck disable=SC2086
	gsettings monitor ${COLOR_SCHEME_KEY} | while read -r _; do
		reload
	done
}

case "${1:-toggle}" in
toggle) toggle ;;
reload) reload ;;
monitor) monitor ;;
*)
	echo "usage: ${0##*/} [toggle|reload|monitor]" >&2
	exit 1
	;;
esac
