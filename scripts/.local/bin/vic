#!/bin/bash

# Help and completion ----------------------------------------------------------

help() {
	echo """vic : vic [args]
    description of the script
    args:
        command  program install on the system"""
}

declare -a COMMANDS=($(compgen -c))

check_args() {
	for c in "${COMMANDS[@]}"; do
		[[ "${c}" == "${1}" ]] && return 0
	done
	return 1
}

if [[ -n "${COMP_LINE}" ]]; then
	for c in "${COMMANDS[@]}"; do
		[[ ${c:0:${#2}} == "${2,,}" ]] && echo "$c"
	done
	exit
fi

if ! check_args "${1}"; then
	help
	exit 1
fi

[[ ${1} == "help" ]] && help && exit 1

# script -----------------------------------------------------------------------

# alias: vi $(command -v "${1}")

vi $(command -v "${1}")
