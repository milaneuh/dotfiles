#!/bin/bash

! command -v fzf >& /dev/null && echo "fzf not installed" && exit 1
! command -v bat >& /dev/null && echo "bat not installed" && exit 1

[[ -n ${TMUX} ]] && cmd="fzf-tmux ${FZF_TMUX_OPTS}" || cmd="fzf"
file=$(${cmd} --preview "bat -p  --theme=${BAT_THEME}  --color=always {1}" --layout=default --preview-window=top:wrap )
# file=$(${cmd} --preview "bat -p  --theme=${BAT_THEME}  --color=always {1}")

# TODO: ne fonctionne pas dans tmux
[[ -n ${file} ]] && echo "vi ${file}" >>~/.bash_history

[[ -n ${file} ]] && vi "${file}"
