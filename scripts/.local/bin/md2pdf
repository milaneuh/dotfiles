#!/bin/bash

[[ -z "${1}" ]] && echo "Missing argument" && exit 1

echo '{"args":["--no-sandbox"]}' > .puppeteer.json

SCRIPT_DIR="$(cd "$(dirname "$(readlink --canonicalize "${BASH_SOURCE[0]}")")" && pwd)"

pandoc \
    --variable mainfont="DejaVu Sans" \
    --pdf-engine=typst \
    --highlight-style zenburn \
	"${1}" --output "${1//md/pdf}"

rm --force .puppeteer.json
